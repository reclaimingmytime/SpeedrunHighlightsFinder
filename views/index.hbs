<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⛏️</text></svg>"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/sakura.css@1.5.1/css/sakura.css"
      integrity="sha256-rFoyAIn+rtUKyWRsd6hDbzlnJmklIRroszMxG/mjxeY="
      crossorigin="anonymous"
    />
    {{#if (or (eq view "dragonrace") (eq view "history") (eq view "deaths"))}}
      <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/gh/tofsjonas/sortable@4.1.7/dist/sortable-base.min.css"
        integrity="sha256-LNw6Q1G7k9QbEjRIWjE5LjXyW4lE3qiqjdm+xSyPk/I="
        crossorigin="anonymous"
      />
    {{/if}}
    {{#if (eq view "splits")}}
      <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/datatables.net-dt@3.1.4/css/dataTables.dataTables.min.css"
        integrity="sha256-FWYk1Tv5OFo3+Ff7wpA2HUEE01NtMJMPuGvOXMDxk4c="
        crossorigin="anonymous"
      />
      <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/datatables.net-columncontrol-dt@2.1.2/css/columnControl.dataTables.min.css"
        integrity="sha256-RASnOXyWq8rbTn+Qt2mkQ6L1knd/nwHHyCZGwTaz0qM="
        crossorigin="anonymous"
      />
    {{/if}}

    <link rel="stylesheet" href="/assets/style.css" />
    <title>
      {{#if user}}
        {{ user }} -
      {{/if}}
      MCSR Ranked Highlights
    </title>
  </head>
  <body>
    <h1>MCSR Ranked Highlights</h1>

    <div style="margin-bottom: 0.75rem;">
      <a class='{{navActive view "latest"}}' href="/">Recent</a>
      |
      <a class='{{navActive view "latestFromHistory"}}' href="/?view=latestFromHistory">Latest from History</a>
      |
      <a class='{{navActive view "history"}}' href="/?view=history">History</a>
      |
      <a class='{{navActive view "deaths"}}' href="/?view=deaths">Deaths</a>
      |
      <a class='{{navActive view "splits"}}' href="/?view=splits">Splits</a>
      |
      <a class='{{navActive view "dragonrace"}}' href="/?view=dragonrace">Dragon Race</a>
    </div>

    {{#if (eq view "latest")}}
      <form id="searchForm">
        <label for="user" style="display: inline">Player:</label>
        <input id="user" type="search" name="user" placeholder="All players" value="{{ user }}" />
        <label for="season" style="display: inline">Season:</label>
        <input
          id="season"
          type="number"
          name="season"
          min="9"
          placeholder="current"
          value="{{ season }}"
          style="display: inline-block; width: 79px"
        />
        <button type="submit">Submit</button>
      </form>
    {{/if}}

    {{#if (eq view "latestFromHistory")}}
      <form id="seasonOnlyForm" method="get" style="margin-bottom:0.5rem; display:inline-block;">
        <input type="hidden" name="view" value="latestFromHistory" />
        <label for="season" style="display:inline">Season:</label>
        <input
          id="season"
          type="number"
          name="season"
          min="9"
          placeholder="current"
          value="{{ season }}"
          style="display:inline-block; width:79px; margin:0 8px;"
        />
        <button type="submit" style="display:inline-block;">Set season</button>
      </form>
      <div id="latestFromHistoryStatus">Loading latest matches...</div>
    {{/if}}

    <div id="latestMatchesContainer">
      {{#if error}}
        <p id="error" style="color: red;">
          {{ error }}
        </p>
      {{else}}
        {{#if (eq view "latest")}}
          {{#if expiredMatchesMessage}}
            <p><em>{{ expiredMatchesMessage }}</em></p>
          {{/if}}
          {{#each vods}}
            <p>
              <a href="?user={{ vodNickname }}" title="See all highlights by player">
                <img class="avatar" src="https://mineskin.eu/avatar/{{ vodNickname }}/8.svg" alt="Player Avatar" />
              </a>
              <a href="{{ vodLink }}" rel="noreferrer" target="_blank">{{ vodNickname }} at {{ vodTime }}</a>
            </p>
          {{else}}
            <p>No highlights found.</p>
          {{/each}}

          {{#if lastMatchId}}
            <hr />
            <p>
              {{#unless expiredMatchesMessage}}
                <a
                  href="?{{#if user}}user={{ user }}&amp;{{/if}}before={{ lastMatchId }}{{#if season}}&amp;season={{ season }}{{/if}}"
                >
                  Previous
                </a>
              {{/unless}}
              {{#if user}}
                {{#unless error}}
                  {{#unless expiredMatchesMessage}}|{{/unless}}
                  <a
                    id="toggleOpponentClips"
                    href="#"
                    data-value="{{#if includeOpponent}}false{{else}}true{{/if}}"
                  >
                    {{#if includeOpponent}}
                      Hide opponent clips
                    {{else}}
                      Include opponent
                    {{/if}}
                  </a>
                {{/unless}}
              {{/if}}
            </p>
          {{/if}}
        {{/if}}
      {{/if}}
    </div>

    {{#if (eq view "history")}}
      <div id="searchHistoryPanel" style="margin-top: 1rem;">
        <p id="historyInfoMessage" style="display:none;"></p>

        <p>
          <button id="recalcLastPublicMatches" type="button" style="display: none;">Calculate latest matches</button>
          <button id="clearHistory" type="button" style="display: none; margin-left: 8px;">Clear history</button>
        </p>
        <table id="historyTable" class="sortable" style="width:100%; border-collapse: collapse; display: none;">
          <thead>
            <tr style="position: sticky; top: 0; background-color: #f9f9f9;">
              <th>Player</th>
              <th>Visits</th>
              <th aria-sort="descending">Last searched</th>
              <th id="lastMatch" class="no-sort">Last streamed match</th>
              <th id="latestMatch" class="no-sort">Latest match</th>
              <th class="no-sort">Delete</th>
            </tr>
          </thead>
          <tbody id="historyTableBody"></tbody>
        </table>
      </div>
    {{/if}}

    {{#if (eq view "dragonrace")}}
      <p>All dragon perch races where both players killed the dragon in previously accessed matches.</p>

      {{#if dragonRaceConditions.length}}
        <table class="sortable">
          <thead>
            <tr style="position: sticky;top: 0;background-color: #f9f9f9;">
              <th>Player</th>
              <th>Difference (secs)</th>
              <th aria-sort="descending">Date & Time</th>
              <th class="no-sort">VOD</th>
            </tr>
          </thead>
          <tbody>
            {{#each dragonRaceConditions}}
              <tr>
                <td>
                  <a href="?user={{ player }}">
                    <img
                      class="avatar"
                      src="https://mineskin.eu/avatar/{{ player }}/8.svg"
                      style="padding-right: 4px"
                      alt="Player Avatar"
                    />
                    {{ player }}
                  </a>
                </td>

                <td>{{ timeDifferenceSeconds }}</td>

                <td data-sort="{{ eventUnix }}">{{ date }}</td>

                <td>
                  <a href="{{ vodLink }}" rel="noreferrer" target="_blank">Watch</a>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      {{else}}
        <p>No cached dragon race conditions found.</p>
      {{/if}}
    {{/if}}

    {{#if (eq view "deaths")}}
      <form class="deaths-filters" action="/" method="get">
        <input type="hidden" name="view" value="deaths" />
        <label for="stage">World stage:</label>
        <select id="stage" name="stage">
          <option
            value="all"
            {{#if (eq selectedStage "all")}}
              selected
            {{/if}}
          >
            All stages
          </option>
          {{#each stages}}
            <option
              value="{{ value }}"
              {{#if (eq ../selectedStage value)}}
                selected
              {{/if}}
            >
              {{ label }}
            </option>
          {{/each}}
        </select>
        <label for="rank">Rank:</label>
        <select id="rank" name="rank">
          <option
            value="all"
            {{#if (eq selectedRank "all")}}
              selected
            {{/if}}
          >
            All ranks
          </option>
          {{#each ranks}}
            <option
              value="{{ name }}"
              {{#if (eq ../selectedRank name)}}
                selected
              {{/if}}
            >
              {{ rankEmoji }}
              {{ rankName }}
            </option>
          {{/each}}
          <option
            value="unranked"
            {{#if (eq selectedRank "—")}}
              selected
            {{/if}}
          >
            Unranked
          </option>
        </select>
        <button type="submit">Filter</button>
      </form>

      <p>
        {{ deaths.length }}
        {{#if (eq deaths.length 1)}}
          death
        {{else}}
          deaths
        {{/if}}
        found.
      </p>

      {{#if deaths.length}}
        <table class="sortable">
          <thead>
            <tr style="position: sticky; top: 0; background-color: #f9f9f9;">
              <th>Player</th>
              <th data-sort-method="number">Rank / Elo</th>
              <th>Stage</th>
              <th aria-sort="descending">VOD Timestamp</th>
            </tr>
          </thead>
          <tbody>
            {{#each deaths}}
              <tr>
                <td>
                  <a href="?user={{ player }}">
                    <img
                      class="avatar"
                      src="https://mineskin.eu/avatar/{{ player }}/8.svg"
                      style="padding-right: 4px"
                      alt="Player Avatar"
                    />
                    {{ player }}
                  </a>
                </td>
                <td
                  data-sort='{{#if (eq rankName "—")}}-1{{else}}{{ elo }}{{/if}}'
                >
                  {{ rankEmoji }}
                  {{ rankName }}
                  {{#unless (eq rankName "—")}}
                    ({{ elo }})
                  {{/unless}}
                </td>
                <td>{{ stageLabel }}</td>
                <td data-sort="{{ eventUnix }}">
                  <a href="{{ vodLink }}" rel="noreferrer" target="_blank">{{ date }}</a>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      {{else}}
        <p>No cached VOD deaths found for this stage.</p>
      {{/if}}
    {{/if}}

    {{#if (eq view "splits")}}
      <p>Time between each progression split in cached matches. VOD links open at the ending split.</p>
      <table id="splitsTable">
        <thead>
          <tr>
            <th>Player</th>
            <th>Rank / Elo</th>
            <th>Split</th>
            <th>Difference</th>
            <th>Date &amp; Time</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    {{/if}}

    {{#if (or (eq view "dragonrace") (eq view "history") (eq view "deaths"))}}
      <script
        src="https://cdn.jsdelivr.net/gh/tofsjonas/sortable@4.1.7/dist/sortable.min.js"
        integrity="sha256-qIfPQq1baWczZMUpr+hQCzHfvj54wuYjvuZDD8abmQ8="
        crossorigin="anonymous"
      ></script>
    {{/if}}
    {{#if (eq view "splits")}}
      <script
        src="https://cdn.jsdelivr.net/npm/datatables.net@3.1.4/js/dataTables.min.js"
        integrity="sha256-NpeqUPZk7UjcPOzR4FTEeXjmut58/R/5FGjNrQbl1B0="
        crossorigin="anonymous"
      ></script>
      <script
        src="https://cdn.jsdelivr.net/npm/datatables.net-columncontrol@2.1.2/js/dataTables.columnControl.min.js"
        integrity="sha256-NCVGCGFlAwm9OjDt0SrEBc7OlfUEOfeicQImjQqlBx0="
        crossorigin="anonymous"
      ></script>
    {{/if}}
    <script src="/assets/script.js"></script>
  </body>
</html>
